# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only). Required for admin actions like deleting
# users or listing emails via auth.admin.* — never expose to the browser.
# Get it from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical app URL used to build redirect targets for Supabase Auth emails.
# Hardcoding this prevents Host-header injection on self-hosted deployments
# where the request Host can be controlled by the client. Falls back to
# request headers when unset (safe behind Vercel's proxy).
APP_URL=https://prode.example.com
